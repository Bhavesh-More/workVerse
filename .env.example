# WorkVerse AI — environment template
# Copy the relevant sections into the ignored local env files:
#   apps/web/.env.local   (browser-visible values only)
#   apps/api/.env         (server-only secrets)
#   .env                  (root, only if you run the optional MinIO compose file)
# Never commit real credentials. All values below are placeholders.

# ---------------------------------------------------------------------------
# Frontend (apps/web/.env.local) — safe to expose to the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Clerk identity (publishable key is public; secret key is server-only for middleware)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ---------------------------------------------------------------------------
# Backend (apps/api/.env) — server-side secrets, never prefix with NEXT_PUBLIC_
# ---------------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Clerk identity verification. JWKS URL / issuer are derived from the publishable key.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev

# Supabase is used ONLY as the PostgreSQL database (identity is Clerk).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key

# Server-side database connection (asyncpg driver). URL-encode special characters.
DATABASE_URL=postgresql+asyncpg://postgres:replace_password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Hosted Ollama Cloud (remote inference ONLY). Multiple keys rotate on rate limit.
OLLAMA_API_KEY=replace_with_ollama_cloud_api_key
# OLLAMA_API_KEYS=key1,key2,key3
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_OUTPUT_TOKENS=800
OLLAMA_TEMPERATURE=0.7

# --- Real-time voice (ElevenLabs ElevenAgents + Ollama Cloud) ---------------
# Server-only. Never prefix any of these with NEXT_PUBLIC_.
VOICE_ENABLED=true
ELEVENLABS_API_KEY=replace_with_restricted_elevenlabs_key
# Default agent for any NPC; map specific NPC ids with ELEVENLABS_AGENT_MAP.
ELEVENLABS_AGENT_ID=replace_with_agent_id
# Optional per-NPC agents, JSON: {"manager": "agent_x", "teammate": "agent_y"}
ELEVENLABS_AGENT_MAP={}
# Shared secret configured in the ElevenLabs agent's Custom LLM secret store. The custom
# LLM server URL points at this API's /api/v1/voice/llm endpoint (use a public tunnel in dev).
VOICE_LLM_BRIDGE_SECRET=replace_with_long_random_secret
# HMAC secret for short-lived context grants binding a conversation to one session+NPC.
VOICE_CONTEXT_GRANT_SECRET=replace_with_a_second_long_random_secret
VOICE_CONTEXT_GRANT_TTL_SECONDS=900
VOICE_LLM_MAX_OUTPUT_TOKENS=220
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Private object storage (optional for the core flow). Local MinIO only.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=workverse_local_user
MINIO_SECRET_KEY=replace_with_local_password
MINIO_BUCKET=workverse-private
MINIO_SECURE=false
MINIO_PRESIGNED_URL_TTL_SECONDS=300
MINIO_MAX_UPLOAD_BYTES=10485760

# Development-only auth bypass. Must remain false in production.
DEV_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# Root .env — only needed to run infra/docker-compose.minio.yml
# Review the MinIO distribution/license before use (see docs/architecture.md).
# ---------------------------------------------------------------------------
MINIO_IMAGE=minio/minio:REVIEW_AND_PIN
MINIO_ROOT_USER=workverse_local_user
MINIO_ROOT_PASSWORD=replace_with_a_long_random_local_password
