{
  "name": "@workverse/api",
  "version": "0.1.0",
  "private": true,
  "description": "Turbo task wrapper for the FastAPI backend (Python deps are managed by uv).",
  "scripts": {
    "dev": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "uv run uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "uv run pytest",
    "test:integration": "WORKVERSE_LIVE=1 uv run pytest tests/test_integration_live.py",
    "lint": "uv run ruff check .",
    "format": "uv run ruff format .",
    "check-types": "uv run ruff check ."
  }
}
